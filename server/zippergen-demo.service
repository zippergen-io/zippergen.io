[Unit]
Description=ZipperGen live Telegram demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zippergen-live
Group=zippergen-live
WorkingDirectory=/opt/zippergen-demo/server
StateDirectory=zippergen-demo
StateDirectoryMode=0700
EnvironmentFile=/etc/zippergen-demo/config
LoadCredential=telegram-token:/etc/zippergen-demo/telegram-token
ExecStart=/opt/zippergen-demo/venv/bin/gunicorn --workers 1 --worker-class gthread --threads 4 --bind 127.0.0.1:8787 --timeout 60 --graceful-timeout 45 live_demo.server:create_app()
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
MemoryMax=512M
TasksMax=128
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zippergen-demo

[Install]
WantedBy=multi-user.target
